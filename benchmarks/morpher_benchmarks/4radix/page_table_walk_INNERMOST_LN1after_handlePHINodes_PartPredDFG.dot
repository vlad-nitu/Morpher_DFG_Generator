digraph Region_18 {
	graph [ nslimit = "1000.0",
	orientation = landscape,
		center = true,
	page = "8.5,11",
	compound=true,
	size = "10,7.5" ] ;
"Op_4" [ fontname = "Helvetica" shape = box, label = " LOOPSTART C=0x0BB=,
4, ASAP=-1, ALAP=-1"]
"Op_0" [ fontname = "Helvetica" shape = box, label = " phi temp14 BB=,
0, ASAP=-1, ALAP=-1"]
"Op_1" [ fontname = "Helvetica" shape = box, label = " icmp temp16  C=0x0BB=,
1, ASAP=-1, ALAP=-1"]
"Op_2" [ fontname = "Helvetica" shape = box, label = " br  BB=,
2, ASAP=-1, ALAP=-1"]
"Op_3" [ fontname = "Helvetica" shape = box, label = " add temp15  C=0xffffffffBB=,
3, ASAP=-1, ALAP=-1"]
"Op_5" [ fontname = "Helvetica" shape = box, label = " CMERGE C=0x3BB=,
5, ASAP=-1, ALAP=-1"]
"Op_6" [ fontname = "Helvetica" shape = box, label = " CMERGEBB=,
6, ASAP=-1, ALAP=-1"]
"Op_0" -> "Op_1" [style = bold, color = black];
"Op_0" -> "Op_3" [style = bold, color = black];
"Op_1" -> "Op_2" [style = bold, color = black];
"Op_1" -> "Op_6" [style = bold, color = red];
"Op_3" -> "Op_6" [style = bold, color = black];
"Op_4" -> "Op_5" [style = bold, color = blue];
"Op_5" -> "Op_0" [style = bold, color = black];
"Op_6" -> "Op_0" [style = dashed, color = black];
}
