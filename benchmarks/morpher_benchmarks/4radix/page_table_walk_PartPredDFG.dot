digraph Region_18 {
	graph [ nslimit = "1000.0",
	orientation = landscape,
		center = true,
	page = "8.5,11",
	compound=true,
	size = "10,7.5" ] ;
"Op_4" [ fontname = "Helvetica" shape = box, label = " LOOPSTART C=0x8190BB= HyIns=LOADB,
4, ASAP=0, ALAP=0"]
"Op_9" [ fontname = "Helvetica" shape = box, label = " STORESTART C=0x8190BB= HyIns=STOREB,
9, ASAP=1, ALAP=4"]
"Op_10" [ fontname = "Helvetica" shape = box, label = " MOVC C=0x0BB= HyIns=MOVC,
10, ASAP=0, ALAP=3"]
"Op_0" [ fontname = "Helvetica" shape = box, label = " phi temp14 BB= HyIns=SELECT,
0, ASAP=2, ALAP=2"]
"Op_1" [ fontname = "Helvetica" shape = box, label = " icmp temp16  C=0x0BB= HyIns=CMP,
1, ASAP=3, ALAP=3"]
"Op_3" [ fontname = "Helvetica" shape = box, label = " add temp15  C=0xffffffffBB= HyIns=ADD,
3, ASAP=3, ALAP=3"]
"Op_5" [ fontname = "Helvetica" shape = box, label = " CMERGE C=0x3BB=,mutex={6,} HyIns=CMERGE,
5, ASAP=1, ALAP=1"]
"Op_6" [ fontname = "Helvetica" shape = box, label = " CMERGEBB=,mutex={5,} HyIns=CMERGE,
6, ASAP=4, ALAP=4"]
"Op_20007" [ fontname = "Helvetica" shape = box, label = " LOOPEXIT C=0x4095BB= HyIns=STOREB,
20007, ASAP=4, ALAP=4"]
"Op_20008" [ fontname = "Helvetica" shape = box, label = " MOVC C=0x1BB= HyIns=MOVC,
20008, ASAP=0, ALAP=3"]
"Op_0" -> "Op_1" [style = bold, color = black];
"Op_0" -> "Op_3" [style = bold, color = black];
"Op_1" -> "Op_6" [style = bold, color = red];
"Op_1" -> "Op_20007" [style = bold, color = blue];
"Op_3" -> "Op_6" [style = bold, color = black];
"Op_4" -> "Op_5" [style = bold, color = blue];
"Op_4" -> "Op_9" [style = bold, color = black];
"Op_5" -> "Op_0" [style = bold, color = black];
"Op_6" -> "Op_0" [style = dashed, color = black];
"Op_20008" -> "Op_20007" [style = bold, color = black];
"Op_10" -> "Op_9" [style = bold, color = black];
}
